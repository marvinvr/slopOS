# slopOS listens on 0.0.0.0. npm start uses 4747; npm run dev proxies to 4748.
PORT=4747

# Generator. Subscription CLIs only — never an API key.
# grok is the default. codex and claude are the other providers. mock is for tests.
SLOPOS_GENERATOR=grok

# Optional data directory. Set this in the environment before startup.
# A value that exists only in this file is applied after the server has already
# chosen its data directory, so it will not move data/.
# SLOPOS_DATA_DIR=

# Jobs that run at once. Default 4.
# SLOPOS_CONCURRENCY=4
# Timeouts in milliseconds. A per-kind value wins. SLOPOS_TIMEOUT_MS covers any kind without its own value.
# Defaults: app 600000 (10 min), view 300000 (5 min).
# SLOPOS_TIMEOUT_MS_APP=600000
# SLOPOS_TIMEOUT_MS_VIEW=300000
# SLOPOS_TIMEOUT_MS=
# Mock provider stream length in milliseconds. Default 6000. Tests set a small value.
# SLOPOS_MOCK_MS=6000

# Grok (ACP: `grok agent stdio`). Model and effort are set on each session with
# session/set_config_option (model, reasoning_effort), so they win over the CLI's own config.
SLOPOS_GROK_BIN=grok
SLOPOS_GROK_MODEL=grok-4.7
SLOPOS_GROK_EFFORT=medium
# Per kind (app = first screens, view = next screens):
# SLOPOS_GROK_MODEL_VIEW=grok-4.7
# SLOPOS_GROK_EFFORT_VIEW=medium

# Codex (`codex exec --json`). Omit the model to use the CLI's own default.
# SLOPOS_CODEX_BIN=codex
# SLOPOS_CODEX_MODEL=
# SLOPOS_CODEX_EFFORT=medium

# Claude (Claude Agent SDK, Claude Code login). Omit the model to use the CLI's own default.
# SLOPOS_CLAUDE_BIN=claude
# SLOPOS_CLAUDE_MODEL=
# SLOPOS_CLAUDE_EFFORT=medium
